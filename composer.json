{
    "name": "tacticmedia/scim",
    "description": "Development monorepo of tacticmedia/scim-server and tacticmedia/scim-server-bundle",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5.0",
        "tacticmedia/scim-server": "@dev",
        "tacticmedia/scim-server-bundle": "@dev"
    },
    "require-dev": {
        "ext-dom": "*",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-pdo_sqlite": "*",
        "ext-phar": "*",
        "ext-reflection": "*",
        "ext-simplexml": "*",
        "ext-sodium": "*",
        "ext-tokenizer": "*",
        "ext-xml": "*",
        "ext-xmlwriter": "*",
        "composer/pcre": "^3.4",
        "doctrine/doctrine-bundle": "^3.3.4",
        "doctrine/orm": "^3.7.6",
        "ergebnis/composer-normalize": "^2.56",
        "friendsofphp/php-cs-fixer": "^3.95.28",
        "nyholm/psr7": "^1.8.2",
        "phpstan/phpstan": "^2.3.5",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phpunit/phpunit": "^13.4.6",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "rector/rector": "^2.8.4",
        "roave/security-advisories": "dev-latest",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "symfony/browser-kit": "^8.1.11",
        "symfony/clock": "^8.1.9",
        "symfony/console": "^8.1.11",
        "symfony/css-selector": "^8.1.10",
        "symfony/dependency-injection": "^8.1.11",
        "symfony/error-handler": "^8.1.10",
        "symfony/form": "^8.1.11",
        "symfony/framework-bundle": "^8.1.11",
        "symfony/http-client": "^8.1.11",
        "symfony/http-kernel": "^8.1.11",
        "symfony/password-hasher": "^8.1",
        "symfony/process": "^8.1.10",
        "symfony/psr-http-message-bridge": "^8.1.9",
        "symfony/security-bundle": "^8.1.11",
        "symfony/twig-bundle": "^8.1.9",
        "symfony/validator": "^8.1.11",
        "tomasvotruba/cognitive-complexity": "^1.3"
    },
    "replace": {
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "conflict": {
        "symfony/browser-kit": ">=8.2",
        "symfony/cache": ">=8.2",
        "symfony/clock": ">=8.2",
        "symfony/config": ">=8.2",
        "symfony/console": ">=8.2",
        "symfony/css-selector": ">=8.2",
        "symfony/dependency-injection": ">=8.2",
        "symfony/doctrine-bridge": ">=8.2",
        "symfony/dom-crawler": ">=8.2",
        "symfony/error-handler": ">=8.2",
        "symfony/event-dispatcher": ">=8.2",
        "symfony/filesystem": ">=8.2",
        "symfony/finder": ">=8.2",
        "symfony/form": ">=8.2",
        "symfony/framework-bundle": ">=8.2",
        "symfony/http-client": ">=8.2",
        "symfony/http-foundation": ">=8.2",
        "symfony/http-kernel": ">=8.2",
        "symfony/options-resolver": ">=8.2",
        "symfony/password-hasher": ">=8.2",
        "symfony/process": ">=8.2",
        "symfony/property-access": ">=8.2",
        "symfony/property-info": ">=8.2",
        "symfony/psr-http-message-bridge": ">=8.2",
        "symfony/rate-limiter": ">=8.2",
        "symfony/routing": ">=8.2",
        "symfony/security-bundle": ">=8.2",
        "symfony/security-core": ">=8.2",
        "symfony/security-csrf": ">=8.2",
        "symfony/security-http": ">=8.2",
        "symfony/stopwatch": ">=8.2",
        "symfony/string": ">=8.2",
        "symfony/symfony": "*",
        "symfony/twig-bridge": ">=8.2",
        "symfony/twig-bundle": ">=8.2",
        "symfony/type-info": ">=8.2",
        "symfony/uid": ">=8.2",
        "symfony/validator": ">=8.2",
        "symfony/var-dumper": ">=8.2",
        "symfony/var-exporter": ">=8.2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "scim-server",
            "options": {
                "reference": "config",
                "symlink": true,
                "versions": {
                    "tacticmedia/scim-server": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "scim-server-bundle",
            "options": {
                "reference": "config",
                "symlink": true,
                "versions": {
                    "tacticmedia/scim-server-bundle": "1.0.x-dev"
                }
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "TacticMedia\\ScimDemo\\IdentityProvider\\": "demo/identity-provider/src/",
            "TacticMedia\\ScimDemo\\ServiceProvider\\": "demo/service-provider/src/",
            "TacticMedia\\ScimDemo\\Tests\\": "tests/demo/",
            "TacticMedia\\ScimServerBundle\\Tests\\": "tests/scim-server-bundle/",
            "TacticMedia\\ScimServer\\Tests\\": "tests/scim-server/",
            "TacticMedia\\Scim\\Tests\\Tooling\\": "tests/tooling/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "bump-after-update": true,
        "optimize-autoloader": true,
        "process-timeout": 0,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "@dev-scripts"
        ],
        "post-update-cmd": [
            "@dev-scripts"
        ],
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-clover var/coverage/clover.xml",
            "@php bin/coverage var/coverage/clover.xml 95"
        ],
        "cs": [
            "@pcs"
        ],
        "cs:check": [
            "@pcs:check"
        ],
        "dependencies": "@php bin/dependencies",
        "dev-scripts": [
            "([ $COMPOSER_DEV_MODE -eq 0 ] || composer normalize)",
            "([ $COMPOSER_DEV_MODE -eq 0 ] || composer normalize scim-server/composer.json)",
            "([ $COMPOSER_DEV_MODE -eq 0 ] || composer normalize scim-server-bundle/composer.json)"
        ],
        "lint": [
            "@composer validate --strict --no-check-all",
            "@composer validate --strict scim-server/composer.json",
            "@composer validate --strict scim-server-bundle/composer.json",
            "@php bin/symfony-pin",
            "@composer normalize --dry-run --diff",
            "@composer normalize --dry-run --diff scim-server/composer.json",
            "@composer normalize --dry-run --diff scim-server-bundle/composer.json",
            "@php bin/console lint:container"
        ],
        "pcs": "@php vendor/bin/php-cs-fixer fix",
        "pcs:check": "@php vendor/bin/php-cs-fixer check --diff",
        "qa": [
            "@rector",
            "@cs",
            "@lint",
            "@dependencies",
            "@stan",
            "@coverage"
        ],
        "qa:check": [
            "@rector:check",
            "@cs:check",
            "@lint",
            "@dependencies",
            "@stan",
            "@coverage"
        ],
        "rector": [
            "@php bin/console cache:warmup",
            "@php vendor/bin/rector"
        ],
        "rector:check": [
            "@php bin/console cache:warmup",
            "@php vendor/bin/rector --dry-run"
        ],
        "stan": "bin/phpstan",
        "test": "phpunit"
    }
}
