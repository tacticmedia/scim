{
    "name": "tacticmedia/scim-demo-identity-provider",
    "description": "Demo identity provider that provisions over SCIM as Entra ID, Okta and Keycloak do",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-pdo_sqlite": "*",
        "doctrine/collections": "^3.1",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "doctrine/persistence": "^4.2",
        "psr/clock": "^1.0",
        "symfony/clock": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/doctrine-bridge": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/form": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/http-client-contracts": "^3.8",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/options-resolver": "^8.1",
        "symfony/routing": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/security-csrf": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/validator": "^8.1"
    },
    "replace": {
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "autoload": {
        "psr-4": {
            "TacticMedia\\ScimDemo\\IdentityProvider\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    }
}
