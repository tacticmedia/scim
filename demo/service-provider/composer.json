{
    "name": "tacticmedia/scim-demo-service-provider",
    "description": "Demo SCIM service provider built on tacticmedia/scim-server-bundle",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-pdo_sqlite": "*",
        "doctrine/collections": "^3.1",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "symfony/clock": "^8.1",
        "symfony/console": "^8.1",
        "symfony/doctrine-bridge": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/routing": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/security-core": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/uid": "^8.1",
        "symfony/validator": "^8.1",
        "tacticmedia/scim-server": "^0.1.2",
        "tacticmedia/scim-server-bundle": "^0.1.2"
    },
    "replace": {
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "autoload": {
        "psr-4": {
            "TacticMedia\\ScimDemo\\ServiceProvider\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    }
}
